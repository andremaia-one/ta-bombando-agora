# Arquivos e diretórios que devem ser ignorados pelo Docker

# Dependências
/node_modules
/.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Arquivos de desenvolvimento
/.git
/.github
/.next
/.vscode
/.idea
/coverage

# Arquivos de log
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Arquivos do sistema
.DS_Store
Thumbs.db

# Arquivos de ambiente (conter informações sensíveis)
.env*
!.env.example

# Outros arquivos de desenvolvimento
/test
/docs
/spec
README.md
CHANGELOG.md
LICENSE